<Window x:Class="IrisPxS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:IrisPxS.Controls"
        mc:Ignorable="d"
        Title="IRIS PxS - フィルムスキャニングシステム (Epson GT-X820)" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F0F0F0" Foreground="#000000" FontFamily="Yu Gothic UI, Segoe UI, メイリオ" FontSize="12">

    <Window.Resources>
        <!-- VB.NET / WinForms Standard Control Styles -->
        <SolidColorBrush x:Key="WinFormBg" Color="#F0F0F0" />
        <SolidColorBrush x:Key="BorderGray" Color="#A0A0A0" />
        <SolidColorBrush x:Key="ControlLightGray" Color="#E1E1E1" />
        <SolidColorBrush x:Key="ButtonHover" Color="#E5F1FB" />
        <SolidColorBrush x:Key="ButtonPressed" Color="#CCE4F7" />
        <SolidColorBrush x:Key="ButtonBorderHover" Color="#0078D7" />

        <!-- WinForms Standard Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlLightGray}" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Height" Value="25" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ButtonHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ButtonBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ButtonPressed}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ButtonBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888888" />
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D0D0D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WinForms Standard GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#B0B0B0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <!-- WinForms Standard TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Height" Value="23" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- WinForms Standard ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="23" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Padding" Value="0,2,0,1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Icon Toggle Button Style -->
        <Style x:Key="IconViewButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="BorderBrush" Value="#A0A0A0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#E6E6E6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CCE4F7" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />  <!-- [上側] Machine Control -->
            <RowDefinition Height="*" />   <!-- [ワークエリア] 3 Columns -->
            <RowDefinition Height="125" /> <!-- [下側] Film Strip -->
            <RowDefinition Height="22" />  <!-- StatusStrip -->
        </Grid.RowDefinitions>

        <!-- ====================================================================== -->
        <!-- 【上側】Machine Control                                                 -->
        <!-- ====================================================================== -->
        <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- 左詰め: Pre-Scan, Scan -->
                    <ColumnDefinition Width="*" />    <!-- 中揃え: IRIS PxS タイポグラフィ -->
                    <ColumnDefinition Width="Auto" /> <!-- 右詰め: 接続機器, 状況LED, Scanner Setting -->
                </Grid.ColumnDefinitions>

                <!-- 左詰め: Pre-Scan / Scan -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPreScan" Content="Pre-Scan" Width="105" Height="32" FontWeight="SemiBold" Click="BtnPreScan_Click" ToolTip="透過光ユニット(TPU)で予備スキャンを実行" />
                    <Button x:Name="BtnScan" Content="Scan" Width="110" Height="32" FontWeight="Bold" Margin="6,0,0,0" Background="#D5E8FF" BorderBrush="#0078D7" Click="BtnScanCurrent_Click" ToolTip="選択コマまたは指定解像度で本スキャンを実行" />
                </StackPanel>

                <!-- 中揃え: IRIS PxS -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="IRIS PxS" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E" FontFamily="Segoe UI, Yu Gothic UI" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Film Scanner Suite" FontSize="11" Foreground="#666666" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </StackPanel>

                <!-- 右詰め: ▼接続機器, 接続状況LED, Scanner Setting (正方形歯車) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="機器:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" FontSize="11" />
                    <ComboBox x:Name="CmbScannerList" Width="180" Height="25" VerticalAlignment="Center" Margin="0,0,8,0" SelectionChanged="CmbScannerList_SelectionChanged" />
                    
                    <!-- 接続状況インジケーター (丸の色で判別) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse x:Name="LedScannerStatus" Width="12" Height="12" Fill="#28A745" Stroke="#1E7E34" StrokeThickness="1" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtScannerStatus" Text="Ready" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#28A745" />
                    </StackPanel>

                    <!-- Scanner Setting (正方形・歯車アイコン) -->
                    <Button x:Name="BtnScannerSetting" Content="⚙" Width="30" Height="30" FontSize="16" FontWeight="Normal" Padding="0" Click="BtnScanDialog_Click" ToolTip="Epson Scan 詳細設定ダイアログを起動" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====================================================================== -->
        <!-- メインワークエリア: 3カラム (左: Data, 中央: Control Panel, 右: Image)     -->
        <!-- ====================================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="230" /> <!-- 【左側】Data Control -->
                <ColumnDefinition Width="*" MinWidth="400" />   <!-- 【中央】Control Panel -->
                <ColumnDefinition Width="290" MinWidth="250" /> <!-- 【右側】Image Control -->
            </Grid.ColumnDefinitions>

            <!-- ================================================================== -->
            <!-- 【左側】Data Control                                                -->
            <!-- ================================================================== -->
            <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#B0B0B0" BorderThickness="0,0,1,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- フィルム種別: Color/B&W, Negative/Positive (最上部) -->
                        <GroupBox Header="フィルム種別">
                            <StackPanel Margin="2">
                                <!-- Color / B&W -->
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbColor" Content="Color (カラー)" IsChecked="True" Grid.Column="0" GroupName="FilmColorType" Click="FilmType_Changed" FontWeight="SemiBold" />
                                    <RadioButton x:Name="RbBw" Content="B&amp;W (モノクロ)" Grid.Column="1" GroupName="FilmColorType" Click="FilmType_Changed" FontWeight="SemiBold" />
                                </Grid>
                                <!-- Negative / Positive -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbNegative" Content="Negative (ネガ)" IsChecked="True" Grid.Column="0" GroupName="FilmPolarityType" Click="FilmType_Changed" FontWeight="SemiBold" />
                                    <RadioButton x:Name="RbPositive" Content="Positive (ポジ)" Grid.Column="1" GroupName="FilmPolarityType" Click="FilmType_Changed" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- ロール管理 -->
                        <GroupBox Header="ロール管理">
                            <StackPanel Margin="2">
                                <Label Content="ロール名 / ID:" />
                                <TextBox x:Name="TxtRollName" Margin="0,0,0,6" TextChanged="TxtRollName_TextChanged" />

                                <Label Content="フィルム銘柄:" />
                                <ComboBox x:Name="CmbFilmBrand" IsEditable="True" Margin="0,0,0,6" SelectionChanged="CmbFilmBrand_SelectionChanged" />

                                <Label Content="ISO感度:" />
                                <ComboBox x:Name="CmbRollIso" IsEditable="True" Margin="0,0,0,4" SelectionChanged="CmbRollIso_SelectionChanged" />
                            </StackPanel>
                        </GroupBox>

                        <!-- フォーマット設定 -->
                        <GroupBox Header="フォーマット設定">
                            <StackPanel Margin="2">
                                <Label Content="フィルムサイズ:" />
                                <ComboBox x:Name="CmbFilmSizeCategory" Margin="0,0,0,6" SelectionChanged="CmbFilmSizeCategory_SelectionChanged" />

                                <Label Content="フォーマット:" />
                                <ComboBox x:Name="CmbFilmFormat" Margin="0,0,0,8" SelectionChanged="CmbFilmFormat_SelectionChanged" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnAutoDetect" Content="自動コマ認識 (傾き自動補正)" Grid.ColumnSpan="2" Height="28" Margin="0,0,0,4" FontWeight="SemiBold" Click="BtnAutoDetectFrames_Click" ToolTip="フィルムの傾き角度と物理mmサイズを検知してコマ枠を正確に自動配置します" />
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnAddFrame" Content="+ コマ枠追加" Grid.Column="0" Margin="0,0,2,0" Click="BtnAddFrame_Click" />
                                    <Button x:Name="BtnDeleteFrame" Content="選択枠削除" Grid.Column="1" Margin="2,0,0,0" Click="BtnDeleteFrame_Click" />
                                </Grid>
                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnNudgeLeftPanelUp" Content="▲ 上へ微調整" Grid.Column="0" Margin="0,0,2,0" Height="24" Click="BtnNudgeUp_Click" ToolTip="全コマを一括で上（手前）へ微調整移動 (矢印キー↑でも可 / Shift併用で大移動)" />
                                    <Button x:Name="BtnNudgeLeftPanelDown" Content="▼ 下へ微調整" Grid.Column="1" Margin="2,0,0,0" Height="24" Click="BtnNudgeDown_Click" ToolTip="全コマを一括で下（奥）へ微調整移動 (矢印キー↓でも可 / Shift併用で大移動)" />
                                </Grid>

                                <!-- 内側トリム (余白カット %) -->
                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="内側トリム (余白カット):" Grid.Column="0" VerticalAlignment="Center" Padding="0" />
                                    <TextBlock x:Name="TxtCropInsetValue" Text="3.0 %" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="SliderCropInset" Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1.0" Value="3.0" Margin="0,2,0,4" ValueChanged="SliderCropInset_ValueChanged" ToolTip="露光枠の黒フチやコマ間隙間が画像内に残らないよう、コマの内側を何%カットして全面写真にするか調整します" />
                            </StackPanel>
                        </GroupBox>

                        <!-- スキャン解像度設定 -->
                        <GroupBox Header="解像度設定">
                            <StackPanel Margin="2">
                                <Label Content="スキャン解像度 (DPI):" />
                                <ComboBox x:Name="CmbDpi" Margin="0,0,0,4" SelectionChanged="CmbDpi_SelectionChanged" />
                                <TextBlock Text="※最大 12800 DPI まで対応" FontSize="10" Foreground="#666666" />
                            </StackPanel>
                        </GroupBox>

                        <!-- エクスポート -->
                        <GroupBox Header="一括書き出し (Export)">
                            <StackPanel Margin="2">
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="出力形式:" Padding="0" VerticalAlignment="Center" />
                                    <ComboBox x:Name="CmbExportFormat" Grid.Column="1" Height="24" SelectionChanged="CmbExportFormat_SelectionChanged">
                                        <ComboBoxItem Content="JPEG (95% 高画質)" IsSelected="True" />
                                        <ComboBoxItem Content="TIFF (16-bit 非圧縮)" />
                                        <ComboBoxItem Content="PNG (ロスレス)" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="ChkOpenFolderAfterExport" Content="完了後に保存先フォルダを開く" IsChecked="True" Margin="0,0,0,6" FontSize="11" />
                                <Button x:Name="BtnExportFolder" Content="フォルダへ一括書き出し..." Height="28" Margin="0,0,0,4" FontWeight="SemiBold" Click="BtnExportFolder_Click" ToolTip="指定フォルダへ全コマを高画質一括保存 (Ctrl+E)" />
                                <Button x:Name="BtnExportZip" Content="ZIPアーカイブへ書き出し..." Height="26" Margin="0,0,0,4" Click="BtnExportZip_Click" ToolTip="全コマを1つのZIP圧縮ファイルに保存" />
                                <Button x:Name="BtnContactSheet" Content="コンタクトシート生成..." Height="25" Margin="0,0,0,2" Click="BtnContactSheet_Click" ToolTip="全コマのインデックスシート画像を生成" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================================================================== -->
            <!-- 【中央】Control Panel                                              -->
            <!-- ================================================================== -->
            <Grid Grid.Column="1" Background="#E0E0E0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" /> <!-- 上部ツールバー (右上にビュー切替ボタン) -->
                    <RowDefinition Height="*" />  <!-- 各種ビュー表示領域 -->
                </Grid.RowDefinitions>

                <!-- 上部コントロールバー -->
                <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,2">
                    <Grid>
                        <!-- 左側: ビュー状態表示 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtViewModeTitle" Text="スキャン全体ビュー" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="4,0,12,0" />
                            <TextBlock x:Name="TxtFrameSummary" Text="0 コマ登録" Foreground="#555555" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 右上: ナッジ、ビュー切替、ズーム、回転、ショートカットヘルプ -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnToolbarNudgeUp" Content="▲" Width="26" Height="26" Margin="1,0" FontWeight="Bold" Click="BtnNudgeUp_Click" ToolTip="全コマを一括で上へ微調整移動 (↑キー / Shift併用で大移動)" />
                            <Button x:Name="BtnToolbarNudgeDown" Content="▼" Width="26" Height="26" Margin="1,0" FontWeight="Bold" Click="BtnNudgeDown_Click" ToolTip="全コマを一括で下へ微調整移動 (↓キー / Shift併用で大移動)" />
                            <Separator Margin="4,2" Width="1" Background="#B0B0B0" />
                            <RadioButton x:Name="RbViewFull" Style="{StaticResource IconViewButtonStyle}" Content="▤" IsChecked="True" ToolTip="スキャン全体ビュー (Ctrl+1)" Click="ViewMode_Changed" />
                            <RadioButton x:Name="RbViewSingle" Style="{StaticResource IconViewButtonStyle}" Content="🖼" ToolTip="コマ個別ビュー (Ctrl+2)" Click="ViewMode_Changed" />
                            <RadioButton x:Name="RbViewTable" Style="{StaticResource IconViewButtonStyle}" Content="⊞" ToolTip="全コマ設定表 (Ctrl+3)" Click="ViewMode_Changed" />
                            <RadioButton x:Name="RbViewIce" Style="{StaticResource IconViewButtonStyle}" Content="⚡" ToolTip="ICE 赤外線差分マップ (Ctrl+4)" Click="ViewMode_Changed" />
                            <Separator Margin="6,2" Width="1" Background="#B0B0B0" />
                            <Button x:Name="BtnZoomOut" Content="−" Width="24" Height="26" Margin="1,0" FontWeight="Bold" Click="BtnZoomOut_Click" ToolTip="表示縮小 (-)" />
                            <Border Background="#FFFFFF" BorderBrush="#A0A0A0" BorderThickness="1" CornerRadius="1" Margin="1,0" Height="26" VerticalAlignment="Center" Padding="4,0">
                                <TextBlock x:Name="TxtZoomLevel" Text="100%" Width="36" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                            </Border>
                            <Button x:Name="BtnZoomIn" Content="＋" Width="24" Height="26" Margin="1,0" FontWeight="Bold" Click="BtnZoomIn_Click" ToolTip="表示拡大 (+)" />
                            <Button x:Name="BtnZoom100" Content="100%" Width="40" Height="26" Margin="2,0" Click="BtnZoom100_Click" ToolTip="等倍表示 (100%)" />
                            <Button x:Name="BtnZoomFit" Content="全体" Width="40" Height="26" Margin="2,0" Click="BtnZoomFit_Click" ToolTip="画面全体に合わせる (Fキー)" />
                            <Button x:Name="BtnRotateRight" Content="⟳" Width="28" Height="26" Margin="2,0" FontSize="13" Click="BtnRotateFrame_Click" ToolTip="90度右回転 (Rキー)" />
                            <Separator Margin="4,2" Width="1" Background="#B0B0B0" />
                            <Button x:Name="BtnShortcutsHelp" Content="⌨" Width="28" Height="26" Margin="2,0" FontSize="13" Click="BtnShortcutsHelp_Click" ToolTip="ショートカットキー早見表 (F1キー)" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 各種ビューのコンテナ -->
                <Grid Grid.Row="1">
                    <!-- ビュー 1: スキャン全体ビュー (FrameCanvas) -->
                    <Grid x:Name="GridFullView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- 展開式 コマ個別制御パネル (上下左右・サイズ・数値入力) -->
                            <RowDefinition Height="*" />    <!-- ScanCanvas -->
                        </Grid.RowDefinitions>

                        <!-- 展開式 コマ個別精密制御パネル -->
                        <Border x:Name="PnlFrameControl" Grid.Row="0" Background="#F0F2F5" BorderBrush="#B0B4BC" BorderThickness="0,0,0,1" Padding="8,4">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- コマ識別バッジ & コマ送り -->
                                <Border x:Name="BadgeFrameSelection" Background="#0078D7" CornerRadius="3" Padding="7,2" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedFrameBadge" Text="コマ #1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" />
                                </Border>
                                <Button x:Name="BtnFrameNavPrev" Content="◀" Width="24" Height="25" Margin="0,0,2,0" FontWeight="Bold" Click="BtnPrevFrame_Click" ToolTip="前のコマを選択 (PageUp)" />
                                <Button x:Name="BtnFrameNavNext" Content="▶" Width="24" Height="25" Margin="0,0,8,0" FontWeight="Bold" Click="BtnNextFrame_Click" ToolTip="次のコマを選択 (PageDown)" />

                                <!-- 方向制御 D-Pad (◀ 左, ▲ 上, ▼ 下, ▶ 右) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="移動:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11" Foreground="#333333" />
                                    <Button x:Name="BtnFrameLeft" Content="◀ 左" Width="38" Height="25" Margin="1,0" FontWeight="Bold" Click="BtnFrameLeft_Click" ToolTip="コマを左へ移動" />
                                    <Button x:Name="BtnFrameUp" Content="▲ 上" Width="38" Height="25" Margin="1,0" FontWeight="Bold" Click="BtnFrameUp_Click" ToolTip="コマを上へ移動" />
                                    <Button x:Name="BtnFrameDown" Content="▼ 下" Width="38" Height="25" Margin="1,0" FontWeight="Bold" Click="BtnFrameDown_Click" ToolTip="コマを下へ移動" />
                                    <Button x:Name="BtnFrameRight" Content="▶ 右" Width="38" Height="25" Margin="1,0" FontWeight="Bold" Click="BtnFrameRight_Click" ToolTip="コマを右へ移動" />
                                </StackPanel>

                                <!-- 移動ステップ (1px / 5px / 10px / 50px) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="刻み:" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11" />
                                    <RadioButton x:Name="RbStep1" Content="1px" IsChecked="True" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11" GroupName="NudgeStep" />
                                    <RadioButton x:Name="RbStep5" Content="5px" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11" GroupName="NudgeStep" />
                                    <RadioButton x:Name="RbStep10" Content="10px" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11" GroupName="NudgeStep" />
                                    <RadioButton x:Name="RbStep50" Content="50px" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11" GroupName="NudgeStep" />
                                </StackPanel>

                                <!-- サイズ調整 (幅-/+, 高さ-/+) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="サイズ:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11" Foreground="#333333" />
                                    <Button x:Name="BtnFrameWidthDec" Content="W -" Width="32" Height="25" Margin="1,0" Click="BtnFrameWidthDec_Click" ToolTip="コマ幅を縮小" />
                                    <Button x:Name="BtnFrameWidthInc" Content="W +" Width="32" Height="25" Margin="1,0" Click="BtnFrameWidthInc_Click" ToolTip="コマ幅を拡大" />
                                    <Button x:Name="BtnFrameHeightDec" Content="H -" Width="32" Height="25" Margin="1,0" Click="BtnFrameHeightDec_Click" ToolTip="コマ高さを縮小" />
                                    <Button x:Name="BtnFrameHeightInc" Content="H +" Width="32" Height="25" Margin="1,0" Click="BtnFrameHeightInc_Click" ToolTip="コマ高さを拡大" />
                                </StackPanel>

                                <!-- 座標・寸法 直接入力 (X, Y, W, H) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="X:" VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#555555" />
                                    <TextBox x:Name="TxtFrameX" Width="44" Height="23" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" KeyDown="TxtFrameCoord_KeyDown" LostFocus="TxtFrameCoord_LostFocus" ToolTip="X座標 (px) - Enterで確定" />
                                    <TextBlock Text="Y:" VerticalAlignment="Center" Margin="3,0,2,0" FontSize="11" Foreground="#555555" />
                                    <TextBox x:Name="TxtFrameY" Width="44" Height="23" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" KeyDown="TxtFrameCoord_KeyDown" LostFocus="TxtFrameCoord_LostFocus" ToolTip="Y座標 (px) - Enterで確定" />
                                    <TextBlock Text="W:" VerticalAlignment="Center" Margin="3,0,2,0" FontSize="11" Foreground="#555555" />
                                    <TextBox x:Name="TxtFrameW" Width="44" Height="23" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" KeyDown="TxtFrameCoord_KeyDown" LostFocus="TxtFrameCoord_LostFocus" ToolTip="幅 (px) - Enterで確定" />
                                    <TextBlock Text="H:" VerticalAlignment="Center" Margin="3,0,2,0" FontSize="11" Foreground="#555555" />
                                    <TextBox x:Name="TxtFrameH" Width="44" Height="23" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" KeyDown="TxtFrameCoord_KeyDown" LostFocus="TxtFrameCoord_LostFocus" ToolTip="高さ (px) - Enterで確定" />
                                </StackPanel>

                                <!-- センタリング & 削除 -->
                                <Button x:Name="BtnFrameCenter" Content="◎ 中央配置" Height="25" Margin="0,0,4,0" Click="BtnFrameCenter_Click" ToolTip="選択コマを画像中央・フィルム幅中央に整列" />
                                <Button x:Name="BtnFrameDeleteQuick" Content="✕ 削除" Height="25" Margin="0,0,8,0" Click="BtnDeleteFrame_Click" ToolTip="選択コマを削除 (Deleteキー)" />

                                <!-- 連動スコープ切替 (選択コマ / 全コマ) -->
                                <Border BorderBrush="#C0C4CC" BorderThickness="1" CornerRadius="3" Background="#FFFFFF" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RbTargetSelectedOnly" Content="選択コマ" IsChecked="True" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold" ToolTip="選択した1コマのみを移動します" GroupName="NudgeScope" />
                                        <RadioButton x:Name="RbTargetAllFrames" Content="全コマ連動" FontSize="11" FontWeight="SemiBold" ToolTip="全コマを一括して移動します" GroupName="NudgeScope" />
                                    </StackPanel>
                                </Border>

                                <!-- マウスドラッグ禁止チェックボックス (非定型操作防止) -->
                                <CheckBox x:Name="ChkLockMouseDrag" Content="ドラッグ変形を禁止" IsChecked="True" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#8B0000" Checked="ChkLockMouseDrag_Changed" Unchecked="ChkLockMouseDrag_Changed" ToolTip="マウスでのドラッグ移動・リサイズ変形を禁止し、ボタンによる定型制御のみを受け付けます" />
                            </WrapPanel>
                        </Border>

                        <controls:FrameCanvas x:Name="ScanCanvas" Grid.Row="1" Background="#333333" />
                    </Grid>

                    <!-- ビュー 2: コマ個別ビュー (Single Frame Positive Preview) -->
                    <Grid x:Name="GridSingleView" Visibility="Collapsed" Background="#282828">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="SingleImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ImgSinglePreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="10" />
                        </ScrollViewer>

                        <!-- コマ送り・クイック調整コントロール -->
                        <Border Grid.Row="1" Background="#3A3A3A" BorderBrush="#555555" BorderThickness="0,1,0,0" Padding="8,2">
                            <Grid>
                                <Button x:Name="BtnBackToFullView" Content="▤ 全体ビューへ戻る" HorizontalAlignment="Left" VerticalAlignment="Center" Height="26" Click="BtnBackToFullView_Click" ToolTip="スキャン全体ビューに切り替え (Ctrl+1)" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="BtnPrevFrame" Content="◀ 前のコマ" Width="90" Height="26" Click="BtnPrevFrame_Click" ToolTip="前のコマへ (PageUp)" />
                                    <TextBlock x:Name="TxtSingleFrameInfo" Text="コマ 1 / 1" Foreground="#FFFFFF" FontWeight="Bold" Margin="16,0" VerticalAlignment="Center" />
                                    <Button x:Name="BtnNextFrame" Content="次のコマ ▶" Width="90" Height="26" Click="BtnNextFrame_Click" ToolTip="次のコマへ (PageDown)" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnSingleAutoTone" Content="🪄 自動トーン" Height="26" Margin="0,0,6,0" Click="BtnAutoTone_Click" ToolTip="このコマの露出・コントラスト・WBを自動最適化 (Ctrl+T)" />
                                    <Button x:Name="BtnSingleRotate" Content="⟳ 90°回転" Height="26" Click="BtnRotateFrame_Click" ToolTip="90度右回転 (Rキー)" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ビュー 3: 全コマ設定表 (DataGrid) -->
                    <Grid x:Name="GridTableView" Visibility="Collapsed" Background="#FFFFFF">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" /> <!-- 一括操作バー -->
                            <RowDefinition Height="*" />  <!-- DataGrid -->
                        </Grid.RowDefinitions>

                        <!-- テーブル一括操作バー -->
                        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnApplySelectedToAll" Content="選択行のカメラ・レンズを全コマにコピー" Height="24" Margin="0,0,6,0" Click="BtnApplySelectedToAll_Click" />
                                <Button x:Name="BtnRenumberFrames" Content="1から連番で再採番" Height="24" Margin="0,0,6,0" Click="BtnRenumberFrames_Click" />
                                <TextBlock Text="※各セルをダブルクリックして値を直接編集できます（コマ飛ばし可能）" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 全コマ設定表 DataGrid -->
                        <DataGrid x:Name="DgFramesTable" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  GridLinesVisibility="All" HeadersVisibility="Column"
                                  HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                                  RowHeaderWidth="0" FontSize="11" SelectionChanged="DgFramesTable_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="コマ番号" Binding="{Binding FrameNumber, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="使用カメラ" Binding="{Binding CameraModel, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                <DataGridTextColumn Header="使用レンズ" Binding="{Binding LensModel, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                <DataGridTextColumn Header="F値" Binding="{Binding FNumber, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                                <DataGridTextColumn Header="SS (秒)" Binding="{Binding ShutterSpeed, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                                <DataGridTextColumn Header="ISO" Binding="{Binding ISO, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                                <DataGridTextColumn Header="露出補正" Binding="{Binding ExposureCompensation, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                                <DataGridTextColumn Header="撮影日" Binding="{Binding DateTaken, StringFormat={}{0:yyyy/MM/dd}, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                <DataGridTextColumn Header="備考 / Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- ビュー 4: ICE 赤外線ゴミ・キズ差分マップビュー -->
                    <Grid x:Name="GridIceDiffView" Visibility="Collapsed" Background="#1A1A1A">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="8,4">
                            <TextBlock Text="赤外線スキャン(IR)から検出されたゴミ・キズの差分マスク (白く光っている箇所が検知された欠陥)" Foreground="#00FFCC" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ImgIceDiffPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="10" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================================================================== -->
            <!-- 【右側】Image Control                                               -->
            <!-- ================================================================== -->
            <Border Grid.Column="2" Background="#F0F0F0" BorderBrush="#B0B0B0" BorderThickness="1,0,0,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- カラー補正 -->
                        <GroupBox Header="カラー補正">
                            <StackPanel Margin="2">
                                <Label Content="ベースカラー (未露光部オレンジマスク):" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnAutoBaseColor" Content="自動検知" Grid.Column="0" Margin="0,0,2,0" Click="BtnAutoBaseColor_Click" ToolTip="未露光部のオレンジマスクを精密自動検知" />
                                    <Button x:Name="BtnEyedropper" Content="スポイト" Grid.Column="1" Margin="2,0,0,0" Click="BtnEyedropper_Click" ToolTip="画面上のフィルム余白をクリックしてベース色を取得" />
                                </Grid>

                                <!-- ベースカラー プレビュー swatch -->
                                <Border Height="24" BorderBrush="#888888" BorderThickness="1" Margin="0,0,0,8">
                                    <Grid>
                                        <Rectangle x:Name="RectBaseColorSwatch" Fill="#D77D4B" />
                                        <TextBlock x:Name="TxtBaseColorRgb" Text="R: 215  G: 125  B: 75" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF">
                                            <TextBlock.Effect>
                                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Color="#000000" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- トーン調整スライダー -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="露出 (EV):" VerticalAlignment="Center" FontSize="11" />
                                    <Slider x:Name="SldExposure" Grid.Column="1" Minimum="-2.0" Maximum="2.0" Value="0.0" SmallChange="0.1" ValueChanged="ToneSlider_ValueChanged" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtExposureVal" Text="0.0" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ｺﾝﾄﾗｽﾄ:" VerticalAlignment="Center" FontSize="11" />
                                    <Slider x:Name="SldContrast" Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="1.0" SmallChange="0.05" ValueChanged="ToneSlider_ValueChanged" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtContrastVal" Text="1.0" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="彩度:" VerticalAlignment="Center" FontSize="11" />
                                    <Slider x:Name="SldSaturation" Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="1.0" SmallChange="0.05" ValueChanged="ToneSlider_ValueChanged" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtSaturationVal" Text="1.0" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="色温度:" VerticalAlignment="Center" FontSize="11" />
                                    <Slider x:Name="SldColorTemp" Grid.Column="1" Minimum="-50" Maximum="50" Value="0" SmallChange="1" ValueChanged="ToneSlider_ValueChanged" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtColorTempVal" Text="0" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="色合い:" VerticalAlignment="Center" FontSize="11" />
                                    <Slider x:Name="SldTint" Grid.Column="1" Minimum="-50" Maximum="50" Value="0" SmallChange="1" ValueChanged="ToneSlider_ValueChanged" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtTintVal" Text="0" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                                </Grid>

                                <Button x:Name="BtnAutoTone" Content="🪄 自動トーン補正 (Auto Tone)" Height="28" Margin="0,6,0,2" FontWeight="Bold" Background="#D5E8FF" BorderBrush="#0078D7" Click="BtnAutoTone_Click" ToolTip="中央部の露光ヒストグラムとRGBバランスを解析し、露出・コントラスト・WBを自動最適化 (Ctrl+T)" />
                                <Button x:Name="BtnApplyToneToAll" Content="このトーン調整を全コマにコピー" Height="26" Margin="0,2,0,6" Click="BtnApplyToneToAll_Click" ToolTip="現在のコマのトーン設定（露出・コントラスト・彩度・色温度・色合い・ベース色）を全コマに一括適用" />

                                <Label Content="クイックトーンプリセット:" Margin="0,2,0,1" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25" />
                                        <RowDefinition Height="25" />
                                    </Grid.RowDefinitions>
                                    <Button x:Name="BtnPresetNeutral" Content="標準 / Neutral" Grid.Row="0" Grid.Column="0" Margin="1" Click="BtnPresetNeutral_Click" ToolTip="自然で素直なニュートラルトーン" />
                                    <Button x:Name="BtnPresetVivid" Content="鮮やか / Vivid" Grid.Row="0" Grid.Column="1" Margin="1" Click="BtnPresetVivid_Click" ToolTip="高コントラスト・高彩度" />
                                    <Button x:Name="BtnPresetCinema" Content="シネマ / Cinema" Grid.Row="1" Grid.Column="0" Margin="1" Click="BtnPresetCinema_Click" ToolTip="ティール＆オレンジの映画風トーン" />
                                    <Button x:Name="BtnPresetHighKey" Content="ハイキー / HighKey" Grid.Row="1" Grid.Column="1" Margin="1" Click="BtnPresetHighKey_Click" ToolTip="明るく柔らかな透明感あるトーン" />
                                </Grid>

                                <Button x:Name="BtnResetColor" Content="トーン設定を初期化" Margin="0,2,0,2" Click="BtnResetColor_Click" />
                            </StackPanel>
                        </GroupBox>

                        <!-- ICE (赤外線ゴミ除去) -->
                        <GroupBox Header="ICE (赤外線ゴミ・キズ除去)">
                            <StackPanel Margin="2">
                                <CheckBox x:Name="ChkIceEnable" Content="Digital ICE 自動ゴミ除去を適用" IsChecked="True" Margin="0,2,0,6" Checked="ChkIceEnable_Changed" Unchecked="ChkIceEnable_Changed" />
                                <Label Content="補正強度:" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="RbIceWeak" Content="弱" Margin="0,0,12,0" GroupName="IceStrength" Checked="RbIceStrength_Checked" />
                                    <RadioButton x:Name="RbIceMedium" Content="標準" IsChecked="True" Margin="0,0,12,0" GroupName="IceStrength" Checked="RbIceStrength_Checked" />
                                    <RadioButton x:Name="RbIceStrong" Content="強" GroupName="IceStrength" Checked="RbIceStrength_Checked" />
                                </StackPanel>
                                <Button x:Name="BtnShowIceDiff" Content="ICE 赤外線差分マップを表示" Height="26" Margin="0,0,0,4" FontWeight="SemiBold" Click="BtnShowIceDiff_Click" ToolTip="赤外線スキャンから検出されたゴミ・キズの差分画像を表示します" />
                                <Button x:Name="BtnRunIceInpaint" Content="ゴミ傷の修復を実行" Click="BtnRunIceInpaint_Click" ToolTip="赤外線マスクを利用したインペイント修復を実行します" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ====================================================================== -->
        <!-- 【下側】Film Strip (サムネイルバー)                                    -->
        <!-- ====================================================================== -->
        <Border Grid.Row="2" Background="#E8E8E8" BorderBrush="#B0B0B0" BorderThickness="0,1,0,0" Padding="6,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="TxtFilmstripHeader" Text="フィルムストリップ (Film Strip)" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="※ダブルクリックで拡大・個別確認 / ホイール左右スクロール" FontSize="10" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="LstFilmStrip" Grid.Row="1" Background="#FFFFFF" BorderBrush="#C0C0C0" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="LstFilmStrip_SelectionChanged"
                         PreviewMouseWheel="LstFilmStrip_PreviewMouseWheel"
                         MouseDoubleClick="LstFilmStrip_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D7" />
                                                <Setter TargetName="Bd" Property="Background" Value="#E5F1FB" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B0D5F7" />
                                                <Setter TargetName="Bd" Property="Background" Value="#F5F9FD" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" Width="98">
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- コマ番号バッジ -->
                                    <TextBlock Text="{Binding FrameNumber, StringFormat='Frame #{0}'}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                    <!-- サムネイル画像 -->
                                    <Border BorderBrush="#999999" BorderThickness="1" Background="#111111" Width="88" Height="60">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding CameraModel}" FontSize="9" Foreground="#666666" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ====================================================================== -->
        <!-- 最下部 StatusStrip                                                     -->
        <!-- ====================================================================== -->
        <Border Grid.Row="3" Background="#F0F0F0" BorderBrush="#B0B0B0" BorderThickness="0,1,0,0" Padding="6,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="準備完了" FontSize="11" Foreground="#333333" VerticalAlignment="Center" />
